{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role, subscription tier, and remote work preferences",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID matching auth.uid"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Email address of the user",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "description": "Phone or WhatsApp contact",
          "maxLength": 50
        },
        "tier": {
          "type": "string",
          "description": "Subscription tier: free, pro, or vip_cabinet",
          "enum": ["free", "pro", "vip_cabinet"]
        },
        "country": {
          "type": "string",
          "description": "Country or location",
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "description": "Professional title or role",
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of last profile update"
        }
      },
      "required": ["id", "name", "email", "tier"]
    },
    "SavedCV": {
      "title": "SavedCV",
      "description": "User customized resume data and template selection",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique CV ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID matching auth.uid"
        },
        "title": {
          "type": "string",
          "description": "Title or label for this resume",
          "maxLength": 150
        },
        "templateId": {
          "type": "string",
          "description": "Template design identifier",
          "enum": ["ai_data_engineer", "executive_remote", "minimal_tech", "academic_research"]
        },
        "accentColor": {
          "type": "string",
          "description": "Hex accent color code",
          "maxLength": 20
        },
        "cvData": {
          "type": "object",
          "description": "Complete structured CV content"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Update timestamp"
        }
      },
      "required": ["id", "userId", "title", "templateId", "accentColor"]
    },
    "DevisRequest": {
      "title": "DevisRequest",
      "description": "Remote mission quote submitted to Cabinet Rabiou Saley",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Quote ID"
        },
        "serviceId": {
          "type": "string",
          "description": "Selected service ID",
          "maxLength": 100
        },
        "workFormat": {
          "type": "string",
          "description": "Work format",
          "enum": ["project", "full_time", "part_time"]
        },
        "durationWeeks": {
          "type": "number",
          "description": "Duration in weeks"
        },
        "complexity": {
          "type": "string",
          "description": "Project complexity level",
          "enum": ["standard", "advanced", "enterprise"]
        },
        "clientName": {
          "type": "string",
          "description": "Client or company representative name",
          "maxLength": 100
        },
        "clientEmail": {
          "type": "string",
          "description": "Client contact email",
          "maxLength": 150
        },
        "clientPhone": {
          "type": "string",
          "description": "Client contact phone or WhatsApp",
          "maxLength": 50
        },
        "clientCompany": {
          "type": "string",
          "description": "Company name",
          "maxLength": 120
        },
        "projectDescription": {
          "type": "string",
          "description": "Summary of requirements",
          "maxLength": 3000
        },
        "ndaRequested": {
          "type": "boolean",
          "description": "Whether an NDA is requested"
        },
        "estimatedCostEUR": {
          "type": "number",
          "description": "Estimated budget in EUR"
        },
        "estimatedCostXOF": {
          "type": "number",
          "description": "Estimated budget in XOF"
        },
        "status": {
          "type": "string",
          "description": "Quote status",
          "enum": ["pending", "reviewed", "accepted", "completed"]
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "clientName", "clientEmail", "projectDescription"]
    },
    "VaultFile": {
      "title": "VaultFile",
      "description": "Client file metadata and delivery record stored in user private vault",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique file identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner freelancer ID matching auth.uid"
        },
        "name": {
          "type": "string",
          "description": "Name of the file with extension",
          "maxLength": 255
        },
        "size": {
          "type": "number",
          "description": "File size in bytes"
        },
        "sizeFormatted": {
          "type": "string",
          "description": "Human readable file size",
          "maxLength": 30
        },
        "type": {
          "type": "string",
          "description": "MIME type or file extension",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "File category",
          "enum": ["livrable", "contrat", "code", "facture", "rapport", "autre"]
        },
        "clientName": {
          "type": "string",
          "description": "Target client name or company",
          "maxLength": 150
        },
        "clientEmail": {
          "type": "string",
          "description": "Target client email address",
          "maxLength": 150
        },
        "uploadedAt": {
          "type": "string",
          "description": "ISO timestamp of upload"
        },
        "downloadCount": {
          "type": "number",
          "description": "Number of times downloaded"
        },
        "status": {
          "type": "string",
          "description": "Status of the file",
          "enum": ["active", "archived"]
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or delivery instructions",
          "maxLength": 1000
        },
        "fileContentBase64": {
          "type": "string",
          "description": "Base64 data or payload for in-browser download and preview"
        },
        "storagePath": {
          "type": "string",
          "description": "Path in Firebase Cloud Storage (e.g. vaultFiles/{userId}/{fileId})",
          "maxLength": 500
        },
        "storageUrl": {
          "type": "string",
          "description": "Public or signed download URL from Firebase Storage",
          "maxLength": 1000
        }
      },
      "required": ["id", "userId", "name", "size", "uploadedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profiles, roles, and settings"
    },
    "/users/{userId}/savedCVs/{cvId}": {
      "schema": "SavedCV",
      "description": "Stores customized CVs belonging to a user"
    },
    "/users/{userId}/vaultFiles/{fileId}": {
      "schema": "VaultFile",
      "description": "Stores files uploaded to the user private Client Vault"
    },
    "/devisRequests/{devisId}": {
      "schema": "DevisRequest",
      "description": "Stores remote mission quote requests submitted to Cabinet Rabiou Saley"
    }
  }
}
